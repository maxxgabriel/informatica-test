<?xml version="1.0" encoding="UTF-8"?>
<!-- Informatica Workflow: wf_DIMENSION_LOAD -->
<!-- Purpose: Weekly dimension refresh -->
<!-- Schedule: Every Sunday at 1:00 AM -->

<WORKFLOW NAME="wf_DIMENSION_LOAD" DESCRIPTION="Weekly Dimension Refresh Workflow" ISVALID="YES" SERVERNAME="IntegrationService">

    <!-- Workflow Variables -->
    <WORKFLOWVARIABLE>
        <WORKFLOWVARIABLENAME="$$LAST_LOAD_DATE" DATATYPE="date/time" DEFAULTVALUE="SYSDATE-7" ISUSERDEF="YES"/>
        <WORKFLOWVARIABLENAME="$$CURRENT_LOAD_DATE" DATATYPE="date/time" DEFAULTVALUE="SYSDATE" ISUSERDEF="YES"/>
        <WORKFLOWVARIABLENAME="$$SOURCE_FILE_PATH" DATATYPE="string" DEFAULTVALUE="$PMSourceFileDir/" ISUSERDEF="YES"/>
        <WORKFLOWVARIABLENAME="$$ERROR_EMAIL_TO" DATATYPE="string" DEFAULTVALUE="etl-team@company.com" ISUSERDEF="YES"/>
        <WORKFLOWVARIABLENAME="$$DBA_EMAIL" DATATYPE="string" DEFAULTVALUE="dba-team@company.com" ISUSERDEF="YES"/>
    </WORKFLOWVARIABLE>

    <!-- Task 1: Start Task -->
    <START_TASK NAME="START" DESCRIPTION="Workflow start"/>

    <!-- Task 2: Command Task - Backup dimensions -->
    <COMMAND_TASK NAME="CMD_BACKUP_DIMENSIONS" DESCRIPTION="Backup dimension tables before load">
        <COMMAND>$PMRootDir/scripts/backup_dimensions.sh</COMMAND>
        <SUCCESS_EMAIL_OPTION>NEVER</SUCCESS_EMAIL_OPTION>
        <FAIL_EMAIL_OPTION>ON_FAILURE</FAIL_EMAIL_OPTION>
        <FAIL_EMAIL_ADDRESS>$$DBA_EMAIL</FAIL_EMAIL_ADDRESS>
    </COMMAND_TASK>

    <!-- Task 3: Command Task - Archive old data -->
    <COMMAND_TASK NAME="CMD_ARCHIVE_OLD_DATA" DESCRIPTION="Archive expired dimension records">
        <COMMAND>$PMRootDir/scripts/archive_dimensions.sh $$LAST_LOAD_DATE</COMMAND>
    </COMMAND_TASK>

    <!-- Task 4: Session - Load Customer Master to Staging -->
    <SESSION NAME="s_LOAD_STG_CUSTOMER_FULL" DESCRIPTION="Full load of customer master" MAPPINGNAME="m_LOAD_STG_CUSTOMER" REUSABLE="NO">
        <SESSTRANSFORMATIONINST TRANSFORMATIONNAME="SRC_CUSTOMER" SOURCETYPE="File">
            <ATTRIBUTE NAME="Source File Directory" VALUE="$$SOURCE_FILE_PATH"/>
            <ATTRIBUTE NAME="Source File Name" VALUE="customer_master.csv"/>
            <ATTRIBUTE NAME="File Type" VALUE="Delimited"/>
            <ATTRIBUTE NAME="Delimiter" VALUE=","/>
            <ATTRIBUTE NAME="Header Options" VALUE="Ignore"/>
        </SESSTRANSFORMATIONINST>
        <CONFIGREFERENCE REFOBJECTNAME="default_session_config" TYPE="Session Configuration"/>
        <SESSIONEXTENSION NAME="Relational Writer" TYPE="Target">
            <ATTRIBUTE NAME="Target Load Type" VALUE="Normal"/>
            <ATTRIBUTE NAME="Truncate target table option" VALUE="YES"/>
            <ATTRIBUTE NAME="Commit Interval" VALUE="10000"/>
        </SESSIONEXTENSION>
    </SESSION>

    <!-- Task 5: Session - Load Product Master to Staging -->
    <SESSION NAME="s_LOAD_STG_PRODUCT_FULL" DESCRIPTION="Full load of product master" MAPPINGNAME="m_LOAD_STG_PRODUCT" REUSABLE="NO">
        <SESSTRANSFORMATIONINST TRANSFORMATIONNAME="SRC_PRODUCT" SOURCETYPE="File">
            <ATTRIBUTE NAME="Source File Directory" VALUE="$$SOURCE_FILE_PATH"/>
            <ATTRIBUTE NAME="Source File Name" VALUE="product_master.csv"/>
            <ATTRIBUTE NAME="File Type" VALUE="Delimited"/>
            <ATTRIBUTE NAME="Delimiter" VALUE=","/>
        </SESSTRANSFORMATIONINST>
        <SESSIONEXTENSION NAME="Relational Writer" TYPE="Target">
            <ATTRIBUTE NAME="Truncate target table option" VALUE="YES"/>
        </SESSIONEXTENSION>
    </SESSION>

    <!-- Task 6: Decision Task - Verify staging loads -->
    <DECISION_TASK NAME="DEC_STAGING_SUCCESS" DESCRIPTION="Check if staging completed successfully">
        <CONDITION>$s_LOAD_STG_CUSTOMER_FULL.Status = SUCCEEDED AND $s_LOAD_STG_PRODUCT_FULL.Status = SUCCEEDED</CONDITION>
    </DECISION_TASK>

    <!-- Task 7: Session - Refresh Customer Dimension -->
    <SESSION NAME="s_REFRESH_CUSTOMER_DIM" DESCRIPTION="Refresh customer dimension" MAPPINGNAME="m_LOAD_CUSTOMER_DIM" REUSABLE="NO">
        <SESSIONEXTENSION NAME="Relational Reader" TYPE="Source">
            <ATTRIBUTE NAME="SQL Query" VALUE="SELECT * FROM STG_CUSTOMER"/>
        </SESSIONEXTENSION>
        <SESSIONEXTENSION NAME="Relational Writer" TYPE="Target">
            <ATTRIBUTE NAME="Target Load Type" VALUE="Normal"/>
            <ATTRIBUTE NAME="Insert" VALUE="YES"/>
            <ATTRIBUTE NAME="Update as Update" VALUE="YES"/>
            <ATTRIBUTE NAME="Update Key" VALUE="CUSTOMER_KEY"/>
        </SESSIONEXTENSION>
        <ATTRIBUTE NAME="Enable High Precision" VALUE="YES"/>
    </SESSION>

    <!-- Task 8: Session - Refresh Product Dimension -->
    <SESSION NAME="s_REFRESH_PRODUCT_DIM" DESCRIPTION="Refresh product dimension" MAPPINGNAME="m_LOAD_PRODUCT_DIM" REUSABLE="NO">
        <SESSIONEXTENSION NAME="Relational Reader" TYPE="Source">
            <ATTRIBUTE NAME="SQL Query" VALUE="SELECT * FROM STG_PRODUCT"/>
        </SESSIONEXTENSION>
        <SESSIONEXTENSION NAME="Relational Writer" TYPE="Target">
            <ATTRIBUTE NAME="Target Load Type" VALUE="Normal"/>
            <ATTRIBUTE NAME="Insert" VALUE="YES"/>
            <ATTRIBUTE NAME="Update as Update" VALUE="YES"/>
            <ATTRIBUTE NAME="Update Key" VALUE="PRODUCT_KEY"/>
        </SESSIONEXTENSION>
    </SESSION>

    <!-- Task 9: Command Task - Update statistics -->
    <COMMAND_TASK NAME="CMD_UPDATE_STATS" DESCRIPTION="Update database statistics">
        <COMMAND>$PMRootDir/scripts/update_statistics.sh DIM_CUSTOMER DIM_PRODUCT</COMMAND>
    </COMMAND_TASK>

    <!-- Task 10: Command Task - Rebuild indexes -->
    <COMMAND_TASK NAME="CMD_REBUILD_INDEXES" DESCRIPTION="Rebuild dimension table indexes">
        <COMMAND>$PMRootDir/scripts/rebuild_indexes.sh</COMMAND>
    </COMMAND_TASK>

    <!-- Task 11: Command Task - Data validation -->
    <COMMAND_TASK NAME="CMD_VALIDATE_DIMENSIONS" DESCRIPTION="Validate dimension data quality">
        <COMMAND>$PMRootDir/scripts/validate_dimensions.sh</COMMAND>
    </COMMAND_TASK>

    <!-- Task 12: Email Task - Success Notification -->
    <EMAIL_TASK NAME="EMAIL_SUCCESS" DESCRIPTION="Send success notification">
        <EMAIL_TO>$$ERROR_EMAIL_TO</EMAIL_TO>
        <EMAIL_SUBJECT>Weekly Dimension Load Completed Successfully</EMAIL_SUBJECT>
        <EMAIL_BODY>
            Workflow: wf_DIMENSION_LOAD
            Status: SUCCESS
            Start Time: $START.StartTime
            End Time: $CMD_VALIDATE_DIMENSIONS.EndTime

            Customer Records Processed: $s_REFRESH_CUSTOMER_DIM.TgtSuccessRows
            Product Records Processed: $s_REFRESH_PRODUCT_DIM.TgtSuccessRows

            All dimension tables refreshed successfully.
        </EMAIL_BODY>
    </EMAIL_TASK>

    <!-- Task 13: Email Task - Failure Notification -->
    <EMAIL_TASK NAME="EMAIL_FAILURE" DESCRIPTION="Send failure notification">
        <EMAIL_TO>$$ERROR_EMAIL_TO</EMAIL_TO>
        <EMAIL_CC>$$DBA_EMAIL</EMAIL_CC>
        <EMAIL_SUBJECT>ALERT: Weekly Dimension Load FAILED</EMAIL_SUBJECT>
        <EMAIL_BODY>
            Workflow: wf_DIMENSION_LOAD
            Status: FAILED
            Time: $START.StartTime

            Please check workflow logs immediately.
            Backup tables are available for recovery if needed.
        </EMAIL_BODY>
    </EMAIL_TASK>

    <!-- Workflow Links -->
    <TASKINSTANCE NAME="START" REUSABLE="NO" TYPE="Start">
        <LINK TOINSTANCE="CMD_BACKUP_DIMENSIONS" CONDITION="UNCONDITIONAL"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="CMD_BACKUP_DIMENSIONS" REUSABLE="NO" TYPE="Command">
        <LINK TOINSTANCE="CMD_ARCHIVE_OLD_DATA" CONDITION="SUCCEEDED"/>
        <LINK TOINSTANCE="EMAIL_FAILURE" CONDITION="FAILED"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="CMD_ARCHIVE_OLD_DATA" REUSABLE="NO" TYPE="Command">
        <LINK TOINSTANCE="s_LOAD_STG_CUSTOMER_FULL" CONDITION="SUCCEEDED"/>
        <LINK TOINSTANCE="s_LOAD_STG_PRODUCT_FULL" CONDITION="SUCCEEDED"/>
        <LINK TOINSTANCE="EMAIL_FAILURE" CONDITION="FAILED"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="s_LOAD_STG_CUSTOMER_FULL" REUSABLE="NO" TYPE="Session">
        <LINK TOINSTANCE="DEC_STAGING_SUCCESS" CONDITION="UNCONDITIONAL"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="s_LOAD_STG_PRODUCT_FULL" REUSABLE="NO" TYPE="Session">
        <LINK TOINSTANCE="DEC_STAGING_SUCCESS" CONDITION="UNCONDITIONAL"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="DEC_STAGING_SUCCESS" REUSABLE="NO" TYPE="Decision">
        <LINK TOINSTANCE="s_REFRESH_CUSTOMER_DIM" CONDITION="TRUE"/>
        <LINK TOINSTANCE="EMAIL_FAILURE" CONDITION="FALSE"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="s_REFRESH_CUSTOMER_DIM" REUSABLE="NO" TYPE="Session">
        <LINK TOINSTANCE="s_REFRESH_PRODUCT_DIM" CONDITION="SUCCEEDED"/>
        <LINK TOINSTANCE="EMAIL_FAILURE" CONDITION="FAILED"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="s_REFRESH_PRODUCT_DIM" REUSABLE="NO" TYPE="Session">
        <LINK TOINSTANCE="CMD_UPDATE_STATS" CONDITION="SUCCEEDED"/>
        <LINK TOINSTANCE="EMAIL_FAILURE" CONDITION="FAILED"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="CMD_UPDATE_STATS" REUSABLE="NO" TYPE="Command">
        <LINK TOINSTANCE="CMD_REBUILD_INDEXES" CONDITION="SUCCEEDED"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="CMD_REBUILD_INDEXES" REUSABLE="NO" TYPE="Command">
        <LINK TOINSTANCE="CMD_VALIDATE_DIMENSIONS" CONDITION="SUCCEEDED"/>
    </TASKINSTANCE>

    <TASKINSTANCE NAME="CMD_VALIDATE_DIMENSIONS" REUSABLE="NO" TYPE="Command">
        <LINK TOINSTANCE="EMAIL_SUCCESS" CONDITION="SUCCEEDED"/>
        <LINK TOINSTANCE="EMAIL_FAILURE" CONDITION="FAILED"/>
    </TASKINSTANCE>

    <!-- Scheduler -->
    <SCHEDULER NAME="weekly_schedule" DESCRIPTION="Run every Sunday at 1 AM">
        <SCHEDULE_TYPE>REPEAT</SCHEDULE_TYPE>
        <START_DATE>2026-03-01</START_DATE>
        <START_TIME>01:00:00</START_TIME>
        <REPEAT_TYPE>WEEKLY</REPEAT_TYPE>
        <REPEAT_INTERVAL>1</REPEAT_INTERVAL>
        <REPEAT_DAY>SUNDAY</REPEAT_DAY>
    </SCHEDULER>

</WORKFLOW>
