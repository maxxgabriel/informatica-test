<?xml version="1.0" encoding="UTF-8"?>
<!-- Informatica Mapping: m_LOAD_STG_PRODUCT -->
<!-- Purpose: Load product data from CSV to staging table -->
<!-- Author: ETL Team -->
<!-- Date: 2026-03-03 -->

<MAPPING NAME="m_LOAD_STG_PRODUCT" DESCRIPTION="Load Product Staging Table" ISVALID="YES">

    <!-- Source Definition - File -->
    <SOURCE NAME="SRC_PRODUCT" TYPE="Flat File" DESCRIPTION="Product master CSV file">
        <SOURCEFIELD NAME="PRODUCT_ID" DATATYPE="string" LENGTH="20"/>
        <SOURCEFIELD NAME="PRODUCT_NAME" DATATYPE="string" LENGTH="100"/>
        <SOURCEFIELD NAME="PRODUCT_DESCRIPTION" DATATYPE="string" LENGTH="500"/>
        <SOURCEFIELD NAME="CATEGORY" DATATYPE="string" LENGTH="50"/>
        <SOURCEFIELD NAME="SUB_CATEGORY" DATATYPE="string" LENGTH="50"/>
        <SOURCEFIELD NAME="BRAND" DATATYPE="string" LENGTH="50"/>
        <SOURCEFIELD NAME="UNIT_PRICE" DATATYPE="decimal" PRECISION="10" SCALE="2"/>
        <SOURCEFIELD NAME="COST_PRICE" DATATYPE="decimal" PRECISION="10" SCALE="2"/>
        <SOURCEFIELD NAME="SUPPLIER_ID" DATATYPE="string" LENGTH="20"/>
        <SOURCEFIELD NAME="SUPPLIER_NAME" DATATYPE="string" LENGTH="100"/>
        <SOURCEFIELD NAME="WEIGHT" DATATYPE="decimal" PRECISION="8" SCALE="2"/>
        <SOURCEFIELD NAME="DIMENSIONS" DATATYPE="string" LENGTH="50"/>
        <SOURCEFIELD NAME="COLOR" DATATYPE="string" LENGTH="30"/>
        <SOURCEFIELD NAME="SIZE" DATATYPE="string" LENGTH="20"/>
        <SOURCEFIELD NAME="MATERIAL" DATATYPE="string" LENGTH="50"/>
        <SOURCEFIELD NAME="STATUS" DATATYPE="string" LENGTH="20"/>
    </SOURCE>

    <!-- Source Qualifier -->
    <TRANSFORMATION NAME="SQ_SRC_PRODUCT" TYPE="Source Qualifier" DESCRIPTION="Read product file">
        <TABLEATTRIBUTE NAME="Select All Fields">YES</TABLEATTRIBUTE>
    </TRANSFORMATION>

    <!-- Expression for metadata -->
    <TRANSFORMATION NAME="EXP_ADD_METADATA" TYPE="Expression" DESCRIPTION="Add load metadata">
        <TRANSFORMFIELD NAME="LOAD_DATE" EXPRESSION="SYSDATE"/>
        <TRANSFORMFIELD NAME="SOURCE_SYSTEM" EXPRESSION="'CSV_FILE'"/>
        <TRANSFORMFIELD NAME="RECORD_ID" EXPRESSION="SEQ_RECORD_ID.NEXTVAL"/>
    </TRANSFORMATION>

    <!-- Sequence Generator -->
    <TRANSFORMATION NAME="SEQ_RECORD_ID" TYPE="Sequence Generator">
        <TABLEATTRIBUTE NAME="Start Value">1</TABLEATTRIBUTE>
        <TABLEATTRIBUTE NAME="Increment By">1</TABLEATTRIBUTE>
    </TRANSFORMATION>

    <!-- Target Definition -->
    <TARGET NAME="STG_PRODUCT" TYPE="Table" LOADTYPE="Normal">
        <TARGETFIELD NAME="RECORD_ID"/>
        <TARGETFIELD NAME="PRODUCT_ID"/>
        <TARGETFIELD NAME="PRODUCT_NAME"/>
        <TARGETFIELD NAME="PRODUCT_DESCRIPTION"/>
        <TARGETFIELD NAME="CATEGORY"/>
        <TARGETFIELD NAME="SUB_CATEGORY"/>
        <TARGETFIELD NAME="BRAND"/>
        <TARGETFIELD NAME="UNIT_PRICE"/>
        <TARGETFIELD NAME="COST_PRICE"/>
        <TARGETFIELD NAME="SUPPLIER_ID"/>
        <TARGETFIELD NAME="SUPPLIER_NAME"/>
        <TARGETFIELD NAME="WEIGHT"/>
        <TARGETFIELD NAME="DIMENSIONS"/>
        <TARGETFIELD NAME="COLOR"/>
        <TARGETFIELD NAME="SIZE"/>
        <TARGETFIELD NAME="MATERIAL"/>
        <TARGETFIELD NAME="STATUS"/>
        <TARGETFIELD NAME="LOAD_DATE"/>
        <TARGETFIELD NAME="SOURCE_SYSTEM"/>
    </TARGET>

</MAPPING>
