<?xml version="1.0" encoding="UTF-8"?>
<!-- Informatica Mapping: m_LOAD_STG_SALES -->
<!-- Purpose: Load sales transaction data from CSV to staging table -->
<!-- Author: ETL Team -->
<!-- Date: 2026-03-03 -->

<MAPPING NAME="m_LOAD_STG_SALES" DESCRIPTION="Load Sales Staging Table" ISVALID="YES">

    <!-- Source Definition - File -->
    <SOURCE NAME="SRC_SALES" TYPE="Flat File" DESCRIPTION="Sales transactions CSV file">
        <SOURCEFIELD NAME="TRANSACTION_ID" DATATYPE="string" LENGTH="30"/>
        <SOURCEFIELD NAME="TRANSACTION_DATE" DATATYPE="date/time"/>
        <SOURCEFIELD NAME="CUSTOMER_ID" DATATYPE="string" LENGTH="20"/>
        <SOURCEFIELD NAME="PRODUCT_ID" DATATYPE="string" LENGTH="20"/>
        <SOURCEFIELD NAME="QUANTITY" DATATYPE="integer"/>
        <SOURCEFIELD NAME="UNIT_PRICE" DATATYPE="decimal" PRECISION="10" SCALE="2"/>
        <SOURCEFIELD NAME="DISCOUNT_PERCENT" DATATYPE="decimal" PRECISION="5" SCALE="2"/>
        <SOURCEFIELD NAME="TAX_AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2"/>
        <SOURCEFIELD NAME="TOTAL_AMOUNT" DATATYPE="decimal" PRECISION="10" SCALE="2"/>
        <SOURCEFIELD NAME="PAYMENT_METHOD" DATATYPE="string" LENGTH="20"/>
        <SOURCEFIELD NAME="STORE_ID" DATATYPE="string" LENGTH="20"/>
        <SOURCEFIELD NAME="REGION" DATATYPE="string" LENGTH="50"/>
    </SOURCE>

    <!-- Source Qualifier -->
    <TRANSFORMATION NAME="SQ_SRC_SALES" TYPE="Source Qualifier" DESCRIPTION="Read sales file">
        <TABLEATTRIBUTE NAME="Select All Fields">YES</TABLEATTRIBUTE>
        <TABLEATTRIBUTE NAME="Source Filter">QUANTITY > 0 AND TOTAL_AMOUNT > 0</TABLEATTRIBUTE>
    </TRANSFORMATION>

    <!-- Expression for metadata -->
    <TRANSFORMATION NAME="EXP_ADD_METADATA" TYPE="Expression" DESCRIPTION="Add load metadata">
        <TRANSFORMFIELD NAME="LOAD_DATE" EXPRESSION="SYSDATE"/>
        <TRANSFORMFIELD NAME="SOURCE_SYSTEM" EXPRESSION="'CSV_FILE'"/>
        <TRANSFORMFIELD NAME="RECORD_ID" EXPRESSION="SEQ_RECORD_ID.NEXTVAL"/>
    </TRANSFORMATION>

    <!-- Sequence Generator -->
    <TRANSFORMATION NAME="SEQ_RECORD_ID" TYPE="Sequence Generator">
        <TABLEATTRIBUTE NAME="Start Value">1</TABLEATTRIBUTE>
        <TABLEATTRIBUTE NAME="Increment By">1</TABLEATTRIBUTE>
    </TRANSFORMATION>

    <!-- Target Definition -->
    <TARGET NAME="STG_SALES" TYPE="Table" LOADTYPE="Normal">
        <TARGETFIELD NAME="RECORD_ID"/>
        <TARGETFIELD NAME="TRANSACTION_ID"/>
        <TARGETFIELD NAME="TRANSACTION_DATE"/>
        <TARGETFIELD NAME="CUSTOMER_ID"/>
        <TARGETFIELD NAME="PRODUCT_ID"/>
        <TARGETFIELD NAME="QUANTITY"/>
        <TARGETFIELD NAME="UNIT_PRICE"/>
        <TARGETFIELD NAME="DISCOUNT_PERCENT"/>
        <TARGETFIELD NAME="TAX_AMOUNT"/>
        <TARGETFIELD NAME="TOTAL_AMOUNT"/>
        <TARGETFIELD NAME="PAYMENT_METHOD"/>
        <TARGETFIELD NAME="STORE_ID"/>
        <TARGETFIELD NAME="REGION"/>
        <TARGETFIELD NAME="LOAD_DATE"/>
        <TARGETFIELD NAME="SOURCE_SYSTEM"/>
    </TARGET>

</MAPPING>
