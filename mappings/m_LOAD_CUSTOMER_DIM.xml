<?xml version="1.0" encoding="UTF-8"?>
<!-- Informatica Mapping: m_LOAD_CUSTOMER_DIM -->
<!-- Purpose: Load Customer Dimension with SCD Type 2 -->
<!-- Author: ETL Team -->
<!-- Date: 2026-03-03 -->

<MAPPING NAME="m_LOAD_CUSTOMER_DIM" DESCRIPTION="Load Customer Dimension with SCD Type 2" ISVALID="YES">

    <!-- Source Qualifier -->
    <TRANSFORMATION NAME="SQ_STG_CUSTOMER" TYPE="Source Qualifier" DESCRIPTION="Read from staging table">
        <TABLEATTRIBUTE NAME="SQL Query">
            <![CDATA[
            SELECT
                CUSTOMER_ID,
                FIRST_NAME,
                LAST_NAME,
                EMAIL,
                PHONE,
                ADDRESS,
                CITY,
                STATE,
                ZIP_CODE,
                COUNTRY,
                REGISTRATION_DATE,
                CUSTOMER_TYPE,
                SOURCE_SYSTEM
            FROM STG_CUSTOMER
            WHERE LOAD_DATE >= $$LAST_EXTRACT_DATE
            ]]>
        </TABLEATTRIBUTE>
    </TRANSFORMATION>

    <!-- Expression Transformation for data cleansing -->
    <TRANSFORMATION NAME="EXP_CLEANSE_CUSTOMER" TYPE="Expression" DESCRIPTION="Cleanse and standardize customer data">
        <TRANSFORMFIELD NAME="CUSTOMER_ID" EXPRESSION="CUSTOMER_ID"/>
        <TRANSFORMFIELD NAME="FIRST_NAME_CLEAN" EXPRESSION="UPPER(LTRIM(RTRIM(FIRST_NAME)))"/>
        <TRANSFORMFIELD NAME="LAST_NAME_CLEAN" EXPRESSION="UPPER(LTRIM(RTRIM(LAST_NAME)))"/>
        <TRANSFORMFIELD NAME="FULL_NAME" EXPRESSION="FIRST_NAME_CLEAN || ' ' || LAST_NAME_CLEAN"/>
        <TRANSFORMFIELD NAME="EMAIL_CLEAN" EXPRESSION="LOWER(LTRIM(RTRIM(EMAIL)))"/>
        <TRANSFORMFIELD NAME="PHONE_CLEAN" EXPRESSION="REPLACECHR(0, PHONE, '()-', '')"/>
        <TRANSFORMFIELD NAME="ADDRESS_CLEAN" EXPRESSION="INITCAP(LTRIM(RTRIM(ADDRESS)))"/>
        <TRANSFORMFIELD NAME="CITY_CLEAN" EXPRESSION="UPPER(LTRIM(RTRIM(CITY)))"/>
        <TRANSFORMFIELD NAME="STATE_CLEAN" EXPRESSION="UPPER(STATE)"/>
        <TRANSFORMFIELD NAME="ZIP_CODE_CLEAN" EXPRESSION="LTRIM(RTRIM(ZIP_CODE))"/>
        <TRANSFORMFIELD NAME="COUNTRY_CLEAN" EXPRESSION="UPPER(COUNTRY)"/>
        <TRANSFORMFIELD NAME="CUSTOMER_TYPE_CLEAN" EXPRESSION="UPPER(CUSTOMER_TYPE)"/>
        <TRANSFORMFIELD NAME="CURRENT_TIMESTAMP" EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>

    <!-- Lookup Transformation to check existing records -->
    <TRANSFORMATION NAME="LKP_DIM_CUSTOMER" TYPE="Lookup" DESCRIPTION="Lookup existing customer records">
        <TABLEATTRIBUTE NAME="Lookup Table">DIM_CUSTOMER</TABLEATTRIBUTE>
        <TABLEATTRIBUTE NAME="Lookup Condition">CUSTOMER_ID = CUSTOMER_ID AND IS_CURRENT = 'Y'</TABLEATTRIBUTE>
        <TABLEATTRIBUTE NAME="Return Fields">
            CUSTOMER_KEY,
            FIRST_NAME,
            LAST_NAME,
            EMAIL,
            PHONE,
            ADDRESS,
            EFFECTIVE_FROM_DATE
        </TABLEATTRIBUTE>
    </TRANSFORMATION>

    <!-- Expression for SCD logic -->
    <TRANSFORMATION NAME="EXP_SCD_LOGIC" TYPE="Expression" DESCRIPTION="Determine insert or update">
        <TRANSFORMFIELD NAME="IS_NEW_RECORD" EXPRESSION="IIF(ISNULL(LKP_CUSTOMER_KEY), 1, 0)"/>
        <TRANSFORMFIELD NAME="IS_CHANGED" EXPRESSION="
            IIF(IS_NEW_RECORD = 1, 0,
                IIF(FIRST_NAME_CLEAN != LKP_FIRST_NAME OR
                    LAST_NAME_CLEAN != LKP_LAST_NAME OR
                    EMAIL_CLEAN != LKP_EMAIL OR
                    PHONE_CLEAN != LKP_PHONE OR
                    ADDRESS_CLEAN != LKP_ADDRESS, 1, 0))"/>
        <TRANSFORMFIELD NAME="NEW_CUSTOMER_KEY" EXPRESSION="IIF(IS_NEW_RECORD = 1 OR IS_CHANGED = 1, SEQ_CUSTOMER_KEY.NEXTVAL, LKP_CUSTOMER_KEY)"/>
        <TRANSFORMFIELD NAME="EFFECTIVE_FROM" EXPRESSION="SYSDATE"/>
        <TRANSFORMFIELD NAME="EFFECTIVE_TO" EXPRESSION="TO_DATE('9999-12-31', 'YYYY-MM-DD')"/>
        <TRANSFORMFIELD NAME="IS_CURRENT_FLAG" EXPRESSION="'Y'"/>
    </TRANSFORMATION>

    <!-- Router Transformation to split records -->
    <TRANSFORMATION NAME="RTR_SCD_ROUTING" TYPE="Router" DESCRIPTION="Route records based on SCD logic">
        <GROUP NAME="NEW_RECORDS" EXPRESSION="IS_NEW_RECORD = 1"/>
        <GROUP NAME="CHANGED_RECORDS" EXPRESSION="IS_CHANGED = 1"/>
        <GROUP NAME="UNCHANGED_RECORDS" EXPRESSION="IS_NEW_RECORD = 0 AND IS_CHANGED = 0"/>
    </TRANSFORMATION>

    <!-- Update Strategy for existing records -->
    <TRANSFORMATION NAME="UPD_EXPIRE_OLD_RECORD" TYPE="Update Strategy" DESCRIPTION="Expire old version">
        <TABLEATTRIBUTE NAME="Update Strategy Expression">DD_UPDATE</TABLEATTRIBUTE>
        <TRANSFORMFIELD NAME="EFFECTIVE_TO_DATE" EXPRESSION="SYSDATE - 1"/>
        <TRANSFORMFIELD NAME="IS_CURRENT" EXPRESSION="'N'"/>
        <TRANSFORMFIELD NAME="UPDATED_DATE" EXPRESSION="SYSDATE"/>
    </TRANSFORMATION>

    <!-- Target Definition -->
    <TARGET NAME="DIM_CUSTOMER" TYPE="Table" LOADTYPE="Normal">
        <TARGETFIELD NAME="CUSTOMER_KEY"/>
        <TARGETFIELD NAME="CUSTOMER_ID"/>
        <TARGETFIELD NAME="FIRST_NAME"/>
        <TARGETFIELD NAME="LAST_NAME"/>
        <TARGETFIELD NAME="FULL_NAME"/>
        <TARGETFIELD NAME="EMAIL"/>
        <TARGETFIELD NAME="PHONE"/>
        <TARGETFIELD NAME="ADDRESS"/>
        <TARGETFIELD NAME="CITY"/>
        <TARGETFIELD NAME="STATE"/>
        <TARGETFIELD NAME="ZIP_CODE"/>
        <TARGETFIELD NAME="COUNTRY"/>
        <TARGETFIELD NAME="REGISTRATION_DATE"/>
        <TARGETFIELD NAME="CUSTOMER_TYPE"/>
        <TARGETFIELD NAME="EFFECTIVE_FROM_DATE"/>
        <TARGETFIELD NAME="EFFECTIVE_TO_DATE"/>
        <TARGETFIELD NAME="IS_CURRENT"/>
        <TARGETFIELD NAME="CREATED_DATE"/>
        <TARGETFIELD NAME="SOURCE_SYSTEM"/>
    </TARGET>

</MAPPING>
