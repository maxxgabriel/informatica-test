# NiFi Configuration
NIFI_HOST=localhost
NIFI_PORT=8080
NIFI_USERNAME=admin
NIFI_PASSWORD=admin
NIFI_USE_SSL=false
NIFI_VERIFY_SSL=false

# Database Configuration - Staging
DB_STG_HOST=localhost
DB_STG_PORT=5432
DB_STG_NAME=staging_db
DB_STG_USER=stg_user
DB_STG_PASSWORD=stg_password

# Database Configuration - Warehouse
DB_DWH_HOST=localhost
DB_DWH_PORT=5432
DB_DWH_NAME=warehouse_db
DB_DWH_USER=dwh_user
DB_DWH_PASSWORD=dwh_password

# File Paths
SOURCE_PATH=/data/input
ARCHIVE_PATH=/data/archive
LOG_PATH=/var/log/nifi-etl

# Email Configuration
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USERNAME=nifi-etl@company.com
SMTP_PASSWORD=smtp_password

# Logging
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development